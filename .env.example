# Server
PORT=8080
ENVIRONMENT=development  # set to "production" to disable Swagger UI

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=expense_tracker

# Auth — required, app panics on startup if missing
JWT_SECRET=your-secret-key-here

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# Anthropic — required, app panics on startup if missing
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6  # optional, leave blank to use default

# Google Sign-In (optional — only needed if using Google OAuth)
GOOGLE_CLIENT_ID=
